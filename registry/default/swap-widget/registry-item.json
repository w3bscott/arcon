{
  "name": "swap-widget",
  "type": "registry:block",
  "title": "SwapWidget",
  "description": "Allow users to swap tokens natively within your app.",
  "dependencies": [
    "@arcforge/core"
  ],
  "files": [
    {
      "path": "registry/default/swap-widget/index.tsx",
      "type": "registry:component",
      "target": "@components/arcforge/swap-widget/index.tsx"
    },
    {
      "path": "registry/default/swap-widget/hooks/useSwap.ts",
      "type": "registry:hook",
      "target": "@components/arcforge/hooks/useSwap.ts"
    },
    {
      "path": "registry/default/swap-widget/transaction-status/index.tsx",
      "type": "registry:component",
      "target": "@components/arcforge/transaction-status/index.tsx"
    }
  ]
}