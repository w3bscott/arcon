{
  "name": "@arcforge/core",
  "version": "0.1.0",
  "description": "Framework-agnostic state management, types, and utilities for ArcForge components.",
  "keywords": [
    "arc",
    "arcforge",
    "circle",
    "app-kit",
    "web3",
    "wallet",
    "stablecoin",
    "usdc",
    "bridge",
    "swap",
    "payments"
  ],
  "author": "ArcForge Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcforge/arcforge.git",
    "directory": "packages/core"
  },
  "homepage": "https://arcblocks.com",
  "bugs": {
    "url": "https://github.com/arcforge/arcforge/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.0"
  }
}
