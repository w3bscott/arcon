{
  "name": "arc-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm registry:build && pnpm -r build",
    "start": "pnpm --dir apps/web start",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r typecheck",
    "registry:build": "npx -y tsx tooling/registry-build.ts",
    "release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm registry:build && pnpm pack"
  },
  "devDependencies": {
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1",
    "vitest": "^2.0.0"
  }
}
